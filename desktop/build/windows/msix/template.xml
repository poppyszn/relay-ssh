<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="relay"
        Arguments=""
        InstallLocation="C:\Program Files\Precious Okpor\Relay">
    </Installer>
    <PackageInformation
        PackageName="Relay"
        PackageDisplayName="Relay"
        PublisherName="CN=Precious Okpor"
        PublisherDisplayName="Precious Okpor"
        Version="0.1.0.0"
        PackageDescription="SSH connection manager and terminal">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.poppyszn.relay-ssh"
                Description="SSH connection manager and terminal"
                DisplayName="Relay"
                ExecutableName="relay"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Relay</DisplayName>
            <PublisherDisplayName>Precious Okpor</PublisherDisplayName>
            <Description>SSH connection manager and terminal</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="relay.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
